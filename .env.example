# Copy to .env and fill in. Read by tajfel/model.py via socioverse.external_events._load_dotenv.
# The LLM key is read from the environment first, then $SV_HOME/.env, ./.env, then the repo root.

# --- provider "openai" (--llm openai), the legacy slot --------------------------------
# Required for --llm openai (any OpenAI-compatible endpoint):
SV_LLM_API_KEY=
# Optional; leave commented for the defaults (OpenAI official API):
# SV_LLM_BASE_URL=https://api.openai.com/v1
# SV_LLM_MODEL=gpt-4o

# --- provider "llm2" (--llm llm2) -----------------------------------------------------
# Fill in the base URL, model and API key for the second LLM. An empty value = disabled.
SV_LLM2_API_KEY=
SV_LLM2_BASE_URL=
SV_LLM2_MODEL=

# --- provider "llm3" (--llm llm3) -----------------------------------------------------
# Fill in the base URL, model and API key for the third LLM. An empty value = disabled.
SV_LLM3_API_KEY=
SV_LLM3_BASE_URL=
SV_LLM3_MODEL=
